{
  "name": "@evavo/vector-cli",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "exports": {
    "./batch-operations": {
      "types": "./src/batch-operations.ts",
      "import": "./dist/batch-operations.js",
      "default": "./dist/batch-operations.js"
    }
  },
  "bin": {
    "evavo-vector": "./bin/evavo-vector.mjs",
    "evavo-vector-print": "./bin/evavo-vector-print.mjs",
    "evavo-dotlottie": "./bin/evavo-dotlottie.mjs",
    "evavo-vector-batch": "./bin/evavo-vector-batch.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/*.test.js"
  },
  "dependencies": {
    "@evavo/job-engine": "workspace:*",
    "@evavo/lottie-engine": "workspace:*",
    "@evavo/motion-engine": "workspace:*",
    "@evavo/raster-engine": "workspace:*",
    "@evavo/vector-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  }
}
