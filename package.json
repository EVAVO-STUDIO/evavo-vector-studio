{
  "name": "evavo-vector-studio",
  "version": "0.4.0",
  "private": true,
  "description": "Professional raster-to-vector, SVG animation and Lottie production platform.",
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "contract:check": "node scripts/check-release-contract.mjs",
    "topology:check": "node scripts/check-topology-contract.mjs",
    "browser-evidence:check": "node scripts/check-browser-evidence-contract.mjs",
    "mcp:check": "node scripts/check-mcp-contract.mjs",
    "motion:check": "node scripts/check-motion-contract.mjs",
    "motion-api:check": "node scripts/check-motion-api-contract.mjs",
    "motion-workspace:check": "node scripts/check-motion-workspace-contract.mjs",
    "build:packages": "turbo run build --filter=@evavo/vector-core --filter=@evavo/raster-engine --filter=@evavo/motion-engine --filter=@evavo/vector-cli --filter=@evavo/vector-mcp",
    "dev": "pnpm build:packages && turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm contract:check && pnpm topology:check && pnpm browser-evidence:check && pnpm mcp:check && pnpm motion:check && pnpm motion-api:check && pnpm motion-workspace:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "vector:build": "turbo run build --filter=@evavo/vector-cli",
    "vector:inspect": "pnpm vector:build && node packages/cli/dist/index.js inspect",
    "vector:optimise": "pnpm vector:build && node packages/cli/dist/index.js optimise",
    "vector:raster:inspect": "pnpm vector:build && node packages/cli/dist/index.js raster:inspect",
    "vector:input-policy": "pnpm vector:build && node packages/cli/dist/index.js input-policy",
    "vector:trace": "pnpm vector:build && node packages/cli/dist/index.js trace",
    "vector:motion:validate": "pnpm vector:build && node packages/cli/dist/index.js motion:validate",
    "vector:motion:inspect": "pnpm vector:build && node packages/cli/dist/index.js motion:inspect",
    "vector:animate-svg": "pnpm vector:build && node packages/cli/dist/index.js animate-svg",
    "vector:manifest": "pnpm vector:build && node packages/cli/dist/index.js manifest",
    "vector:mcp:build": "turbo run build --filter=@evavo/vector-mcp",
    "vector:mcp": "pnpm vector:mcp:build && node packages/mcp/dist/index.js"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
