{
  "name": "evavo-vector-studio",
  "version": "0.4.0",
  "private": true,
  "description": "Professional raster-to-vector, SVG animation and Lottie production platform.",
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "contract:check": "node scripts/check-release-contract.mjs",
    "release-proof:check": "node scripts/check-release-proof-contract.mjs",
    "release:source-proof": "node scripts/create-source-proof.mjs",
    "release:live-proof": "node scripts/verify-live-deployment.mjs",
    "capabilities-api:check": "node scripts/check-capabilities-api-contract.mjs",
    "hub:check": "node scripts/check-hub-integration-contract.mjs",
    "private-response:check": "node scripts/check-private-response-contract.mjs",
    "vercel:check": "node scripts/check-vercel-deployment-contract.mjs",
    "vercel-provision:check": "node scripts/check-vercel-project-provisioning-contract.mjs",
    "vercel-deploy:check": "node scripts/check-vercel-production-deployment-contract.mjs",
    "topology:check": "node scripts/check-topology-contract.mjs",
    "browser-evidence:check": "node scripts/check-browser-evidence-contract.mjs",
    "mcp:check": "node scripts/check-mcp-contract.mjs",
    "motion:check": "node scripts/check-motion-contract.mjs",
    "motion-api:check": "node scripts/check-motion-api-contract.mjs",
    "motion-workspace:check": "node scripts/check-motion-workspace-contract.mjs",
    "native-runtime:check": "node scripts/check-native-runtime-boundary.mjs",
    "lottie:check": "node scripts/check-lottie-contract.mjs",
    "lottie-api:check": "node scripts/check-lottie-api-contract.mjs",
    "lottie-workspace:check": "node scripts/check-lottie-workspace-contract.mjs",
    "dotlottie:check": "node scripts/check-dotlottie-contract.mjs",
    "dotlottie-api:check": "node scripts/check-dotlottie-api-contract.mjs",
    "dotlottie-workspace:check": "node scripts/check-dotlottie-workspace-contract.mjs",
    "batch:check": "node scripts/check-batch-contract.mjs",
    "hosted-jobs:check": "node scripts/check-hosted-job-contract.mjs",
    "worker:check": "node scripts/check-worker-contract.mjs",
    "local-worker:check": "node scripts/check-local-worker-contract.mjs",
    "worker-api:check": "node scripts/check-worker-api-contract.mjs",
    "worker-client:check": "node scripts/check-worker-client-contract.mjs",
    "http-worker:check": "node scripts/check-http-worker-contract.mjs",
    "object-transfer-api:check": "node scripts/check-object-transfer-api-contract.mjs",
    "build:packages": "turbo run build --filter=@evavo/hub-auth --filter=@evavo/vector-core --filter=@evavo/raster-engine --filter=@evavo/motion-engine --filter=@evavo/lottie-engine --filter=@evavo/job-engine --filter=@evavo/job-control --filter=@evavo/worker-engine --filter=@evavo/worker-protocol --filter=@evavo/worker-client --filter=@evavo/local-worker --filter=@evavo/http-worker --filter=@evavo/vector-cli --filter=@evavo/vector-jobs --filter=@evavo/vector-mcp",
    "dev": "pnpm build:packages && turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm contract:check && pnpm release-proof:check && pnpm capabilities-api:check && pnpm hub:check && pnpm private-response:check && pnpm vercel:check && pnpm vercel-provision:check && pnpm vercel-deploy:check && pnpm topology:check && pnpm browser-evidence:check && pnpm mcp:check && pnpm motion:check && pnpm motion-api:check && pnpm motion-workspace:check && pnpm native-runtime:check && pnpm lottie:check && pnpm lottie-api:check && pnpm lottie-workspace:check && pnpm dotlottie:check && pnpm dotlottie-api:check && pnpm dotlottie-workspace:check && pnpm batch:check && pnpm hosted-jobs:check && pnpm worker:check && pnpm local-worker:check && pnpm worker-api:check && pnpm worker-client:check && pnpm http-worker:check && pnpm object-transfer-api:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "vector:build": "turbo run build --filter=@evavo/vector-cli",
    "vector:inspect": "pnpm vector:build && node packages/cli/dist/index.js inspect",
    "vector:optimise": "pnpm vector:build && node packages/cli/dist/index.js optimise",
    "vector:raster:inspect": "pnpm vector:build && node packages/cli/dist/index.js raster:inspect",
    "vector:input-policy": "pnpm vector:build && node packages/cli/dist/index.js input-policy",
    "vector:trace": "pnpm vector:build && node packages/cli/dist/index.js trace",
    "vector:motion:validate": "pnpm vector:build && node packages/cli/dist/index.js motion:validate",
    "vector:motion:inspect": "pnpm vector:build && node packages/cli/dist/index.js motion:inspect",
    "vector:animate-svg": "pnpm vector:build && node packages/cli/dist/index.js animate-svg",
    "vector:lottie:inspect": "pnpm vector:build && node packages/cli/dist/index.js lottie:inspect",
    "vector:lottie:export": "pnpm vector:build && node packages/cli/dist/index.js lottie:export",
    "vector:dotlottie:package": "pnpm vector:build && node packages/cli/dist/dotlottie-cli.js package",
    "vector:dotlottie:inspect": "pnpm vector:build && node packages/cli/dist/dotlottie-cli.js inspect",
    "vector:dotlottie:capabilities": "pnpm vector:build && node packages/cli/dist/dotlottie-cli.js capabilities",
    "vector:batch:run": "pnpm vector:build && node packages/cli/dist/batch-cli.js run",
    "vector:batch:inspect": "pnpm vector:build && node packages/cli/dist/batch-cli.js inspect",
    "vector:batch:capabilities": "pnpm vector:build && node packages/cli/dist/batch-cli.js capabilities",
    "vector:manifest": "pnpm vector:build && node packages/cli/dist/index.js manifest",
    "vector:mcp:build": "turbo run build --filter=@evavo/vector-mcp",
    "vector:mcp": "pnpm vector:mcp:build && node packages/mcp/dist/index.js",
    "worker:build": "turbo run build --filter=@evavo/local-worker",
    "worker:capabilities": "pnpm worker:build && node workers/local-worker/dist/index.js capabilities",
    "worker:import": "pnpm worker:build && node workers/local-worker/dist/index.js import",
    "worker:submit": "pnpm worker:build && node workers/local-worker/dist/index.js submit",
    "worker:inspect": "pnpm worker:build && node workers/local-worker/dist/index.js inspect",
    "worker:list": "pnpm worker:build && node workers/local-worker/dist/index.js list",
    "worker:cancel": "pnpm worker:build && node workers/local-worker/dist/index.js cancel",
    "worker:reclaim": "pnpm worker:build && node workers/local-worker/dist/index.js reclaim",
    "worker:run-once": "pnpm worker:build && node workers/local-worker/dist/index.js run-once",
    "worker:run": "pnpm worker:build && node workers/local-worker/dist/index.js run",
    "http-worker:build": "turbo run build --filter=@evavo/http-worker",
    "http-worker:capabilities": "pnpm http-worker:build && node workers/http-worker/dist/index.js capabilities",
    "http-worker:run-once": "pnpm http-worker:build && node workers/http-worker/dist/index.js run-once",
    "http-worker:run": "pnpm http-worker:build && node workers/http-worker/dist/index.js run"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
