{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evavo.com.au/schemas/vector-studio/batch-v1.schema.json",
  "title": "EVAVO Vector Studio Durable Batch Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "name", "failureMode", "items"],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 500
    },
    "version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "failureMode": {
      "enum": ["continue", "fail-fast"]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation", "spec"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:-]{0,63}$"
        },
        "spec": {
          "type": "object"
        }
      }
    }
  }
}
