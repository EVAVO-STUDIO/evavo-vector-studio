{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evavo.com.au/schemas/vector-studio/motion-v1.schema.json",
  "title": "EVAVO Vector Studio Animated SVG Motion Plan v1",
  "description": "Bounded ID-targeted opacity and transform animation for governed SVG assets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "durationMs", "tracks"],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "durationMs": {
      "type": "integer",
      "minimum": 16,
      "maximum": 3600000
    },
    "delayMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600000,
      "default": 0
    },
    "iterations": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        {
          "const": "infinite"
        }
      ],
      "default": 1
    },
    "direction": {
      "enum": ["normal", "reverse", "alternate", "alternate-reverse"],
      "default": "normal"
    },
    "fillMode": {
      "enum": ["none", "forwards", "backwards", "both"],
      "default": "both"
    },
    "reducedMotion": {
      "enum": ["source", "first-frame", "last-frame"],
      "default": "source"
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/track"
      }
    }
  },
  "$defs": {
    "easing": {
      "oneOf": [
        {
          "enum": ["linear", "ease", "ease-in", "ease-out", "ease-in-out"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["cubicBezier"],
          "properties": {
            "cubicBezier": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "prefixItems": [
                { "type": "number", "minimum": 0, "maximum": 1 },
                { "type": "number", "minimum": -10, "maximum": 10 },
                { "type": "number", "minimum": 0, "maximum": 1 },
                { "type": "number", "minimum": -10, "maximum": 10 }
              ],
              "items": false
            }
          }
        }
      ]
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset"],
      "properties": {
        "offset": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "translateX": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000,
          "default": 0
        },
        "translateY": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000,
          "default": 0
        },
        "scale": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 1000,
          "default": 1
        },
        "rotateDeg": {
          "type": "number",
          "minimum": -36000,
          "maximum": 36000,
          "default": 0
        }
      },
      "anyOf": [
        { "required": ["opacity"] },
        { "required": ["translateX"] },
        { "required": ["translateY"] },
        { "required": ["scale"] },
        { "required": ["rotateDeg"] }
      ]
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "keyframes"],
      "properties": {
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,255}$"
        },
        "transformBox": {
          "enum": ["fill-box", "view-box"],
          "default": "fill-box"
        },
        "originXPercent": {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000,
          "default": 50
        },
        "originYPercent": {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000,
          "default": 50
        },
        "easing": {
          "$ref": "#/$defs/easing"
        },
        "keyframes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/keyframe"
          }
        }
      }
    }
  }
}
