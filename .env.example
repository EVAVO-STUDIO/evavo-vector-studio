# Required by authenticated API routes when NODE_ENV=production.
# Use a long random value and keep it server-side. The browser workspace accepts
# a token per tab rather than embedding it in a NEXT_PUBLIC variable.
VECTOR_API_TOKEN=replace-with-a-long-random-secret

# Maximum wall-clock time for one bounded raster operation.
# Integer milliseconds from 5000 to 180000. Default: 45000.
VECTOR_TRACE_TIMEOUT_MS=45000

# Maximum native trace operations executing concurrently in one runtime instance.
# Integer from 1 to 4. Default: 1. Increase only after memory and latency evidence.
VECTOR_TRACE_MAX_CONCURRENT=1

# Retry-After value returned when the per-instance runtime is at capacity.
# Integer seconds from 1 to 60. Default: 5.
VECTOR_TRACE_RETRY_AFTER_SECONDS=5

# Canonical filesystem roots available to the local MCP stdio server.
# When omitted, only the MCP process working directory is allowed.
# Use the operating-system path delimiter: semicolon on Windows, colon on Unix.
VECTOR_MCP_ALLOWED_ROOTS=C:\GitRepos\evavo-vector-studio;C:\EVAVO\VectorAssets

# Hosted job record store. Leave disabled until a durable adapter is deliberately
# configured. The current file adapter records intent, status and receipts but does
# not schedule or execute remote work.
VECTOR_JOB_STORE_MODE=disabled

# Shared by the hosted-job API record adapter and local worker process. In local
# development the worker defaults to .evavo-vector-hosted-jobs when omitted.
VECTOR_JOB_STORE_PATH=C:\EVAVO\VectorWorker\jobs

# Immutable source and generated-object root used by evavo-vector-worker.
# The local worker defaults to .evavo-vector-objects when omitted.
VECTOR_OBJECT_STORE_PATH=C:\EVAVO\VectorWorker\objects

# Portable local worker identity written to leases and heartbeat evidence.
VECTOR_WORKER_ID=greg-workstation-01

# Production API file mode fails closed unless this is true. Set it only when the
# job-store path is backed by a persistent mounted volume. Ephemeral serverless
# filesystems must not claim durable hosted job records.
VECTOR_JOB_FILE_STORE_PERSISTENT=false
