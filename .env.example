# Required by authenticated production API routes and trusted machine clients.
# Use a long random value and keep it server-side. Signed browser workspaces can
# use the app-private session boundary instead of exposing this token.
VECTOR_API_TOKEN=replace-with-a-long-random-secret

# Canonical private application origin. Production accepts only this exact HTTPS
# host; local development may use http://localhost:3000.
VECTOR_PUBLIC_ORIGIN=https://vector.evavo.com.au

# Shared only between the EVAVO hub handoff issuer and Vector Studio receiver.
# Exact 32-512 characters, no surrounding whitespace, and different from every
# browser-session, worker, API and provider credential.
EVAVO_CLIENT_APP_LAUNCH_SECRET=replace-with-a-dedicated-hub-handoff-secret

# Exists only in Vector Studio and signs the eight-hour HttpOnly workspace session.
# It must never equal EVAVO_CLIENT_APP_LAUNCH_SECRET.
EVAVO_VECTOR_PRIVATE_SIGNING_SECRET=replace-with-a-vector-private-session-secret

# Signed handoff replay mode: disabled, memory or upstash. Production forbids
# memory and fails closed unless durable atomic replay storage is configured.
VECTOR_HUB_REPLAY_MODE=disabled
UPSTASH_REDIS_REST_URL=https://replace-with-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-a-server-only-standard-token

# Required by every worker-control and object-transfer API route in every
# environment. Keep this separate from VECTOR_API_TOKEN and never expose it to
# browsers or public environment variables.
VECTOR_WORKER_API_TOKEN=replace-with-a-different-long-random-secret

# Base URL used by evavo-vector-http-worker for authenticated lease coordination.
# Non-local HTTP is rejected unless --allow-insecure-http is deliberately supplied.
VECTOR_WORKER_CONTROL_URL=https://vector.evavo.com.au

# Select the HTTP worker object transport. file uses a trusted shared volume;
# http uses the authenticated worker object-transfer API with SHA-256 verification.
VECTOR_HTTP_WORKER_OBJECT_STORE_MODE=file

# Maximum wall-clock time for one bounded raster operation.
# Integer milliseconds from 5000 to 180000. Default: 45000.
VECTOR_TRACE_TIMEOUT_MS=45000

# Maximum native trace operations executing concurrently in one runtime instance.
# Integer from 1 to 4. Default: 1. Increase only after memory and latency evidence.
VECTOR_TRACE_MAX_CONCURRENT=1

# Retry-After value returned when the per-instance runtime is at capacity.
# Integer seconds from 1 to 60. Default: 5.
VECTOR_TRACE_RETRY_AFTER_SECONDS=5

# Canonical filesystem roots available to the local MCP stdio server.
# When omitted, only the MCP process working directory is allowed.
# Use the operating-system path delimiter: semicolon on Windows, colon on Unix.
VECTOR_MCP_ALLOWED_ROOTS=C:\GitRepos\evavo-vector-studio;C:\EVAVO\VectorAssets

# Hosted job record store. Leave disabled until a durable adapter is deliberately
# configured. The current file adapter records intent, status and receipts but does
# not automatically schedule remote work.
VECTOR_JOB_STORE_MODE=disabled

# Shared by the hosted-job API record adapter and local worker process. In local
# development the worker defaults to .evavo-vector-hosted-jobs when omitted.
VECTOR_JOB_STORE_PATH=C:\EVAVO\VectorWorker\jobs

# Worker object-transfer API store. Leave disabled on ordinary web deployments.
# Set to file only when the web process has a trusted persistent mounted volume.
VECTOR_OBJECT_STORE_MODE=disabled

# Immutable source and generated-object root used by local and HTTP workers. When
# object transfer is enabled, the web process must resolve this same trusted store.
VECTOR_OBJECT_STORE_PATH=C:\EVAVO\VectorWorker\objects

# Portable worker identity written to leases and heartbeat evidence.
VECTOR_WORKER_ID=greg-workstation-01

# Production API file-mode acknowledgements. These flags are operator assertions,
# not automatic persistence proof. Never enable them on ephemeral serverless disks.
VECTOR_JOB_FILE_STORE_PERSISTENT=false
VECTOR_OBJECT_FILE_STORE_PERSISTENT=false
